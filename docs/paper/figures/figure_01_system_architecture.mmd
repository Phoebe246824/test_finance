    F2[事件库与事件详情]:::frontend
    F3[人物图谱]:::frontend
    F4[黑名单管理]:::frontend
    F5[总览与系统状态]:::frontend
  end

  subgraph L2[接口服务层]
    direction LR
    A0[FastAPI 后端 API 服务]:::api
    A1[事件分析 API]:::api
    A2[图谱查询 API]:::api
    A3[黑名单与复核 API]:::api
    A4[健康检查与报告导出]:::api
  end

  subgraph L3[多智能体编排层]
    direction LR
    W0[CrewAI Flow 编排]:::agent
    W1[事件标准化 Agent]:::agent
    W3[事件分类 Agent]:::agent
    W4[风险评估 Agent]:::agent
    W7[意图分析 Agent]:::agent
    W8[趋势预测 Agent]:::agent
  end

  subgraph L4[本地工具与数据层]
    direction LR
    D1[Redis 黑名单 / 高危样本]:::data
    D2[Milvus 低风险向量暂存 / 相似召回]:::data
    D3[Neo4j 关系图谱 / 证据链]:::data
    D4[SQLite 分析结果 / 复核动作]:::data
    D5[JSON 报告 / 日志 / 截图]:::data
  end

  subgraph L5[本地模型推理层]
    direction LR
    M1[Qwen3.6-35B-A3B<br/>风险解释 / 报告生成]:::model
    M2[BGE M3<br/>事件向量化]:::model
    M3[BGE Reranker v2-m3<br/>召回重排]:::model
    M4[OpenAI 兼容接口<br/>智能体统一调用]:::model
  end

  subgraph L6[端侧硬件平台层]
    direction LR
    H0[AMD 锐龙 AI MAX+ 平台]:::hw
    H1[CPU: API 服务 / Agent 调度 / 规则逻辑 / 接口调用]:::hw
    H2[Radeon GPU: llama.cpp / Q6_K_M 量化 LLM]:::hw
    H3[Ryzen AI NPU: BGE M3 / BGE Reranker v2-m3]:::hw
    H4[统一内存 + SSD: 多服务并行与本地持久化]:::hw
  end

