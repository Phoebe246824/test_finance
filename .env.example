# ============ 本地 Web 服务 ============
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
VITE_API_BASE_URL=http://127.0.0.1:8000

# ============ Neo4j 配置 ============
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pa55w0rd
NEO4J_DATABASE=neo4j
# 调试模式：设为 true 跳过 Neo4j 写入（LLM 提取仍会执行）
GRAPHITI_DRY_RUN=false

# ============ 参赛目标平台 ============
SENTINEL_TARGET_PLATFORM=AMD Ryzen AI MAX+ 395 Mini AI Workstation
# 在 AMD 云端环境部署 ROCm / Ryzen AI SDK 后可显式标记后端，便于报告留痕
SENTINEL_GPU_BACKEND=rocm
SENTINEL_NPU_BACKEND=ryzen-ai-sdk
# RYZEN_AI_HOME=/opt/ryzen-ai

# ============ LLM 配置 (聊天模型) ============
# 参赛建议：优先接入本地 OpenAI-compatible 服务，核心推理不上传隐私数据。
# 示例 A: LM Studio
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen2.5-14b-instruct
#   LLM_API_KEY=lm-studio
#   LLM_BASE_URL=http://127.0.0.1:1234/v1
# 示例 B: Ollama OpenAI-compatible endpoint
#   LLM_PROVIDER=openai
#   LLM_MODEL=qwen2.5:14b-instruct-q4_K_M
#   LLM_API_KEY=ollama
#   LLM_BASE_URL=http://127.0.0.1:11434/v1
LLM_PROVIDER=openai
LLM_MODEL=qwen3.5
LLM_API_KEY=ollama
LLM_BASE_URL=http://127.0.0.1:11434/v1
# 抽取档（高频 JSON：normalize/classify/Graphiti）；留空回退 LLM_*
LLM_EXTRACT_BASE_URL=
LLM_EXTRACT_MODEL=
LLM_EXTRACT_API_KEY=
# 研判档（reasoning：风险评估/报告）；留空回退 LLM_*
LLM_REASON_BASE_URL=
LLM_REASON_MODEL=
LLM_REASON_API_KEY=
# 研判档 reasoning 上限（控演示延迟）
REASON_MAX_ATTEMPTS=2
REASON_MAX_STEPS=4

# ============ Embedding 配置 (嵌入模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_API_KEY=local-dev-key
EMBEDDER_API_BASE=http://127.0.0.1:1234/v1

# ============ Reranker 配置 (重排序模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=
RERANKER_BASE_URL=

# ============ 搜索配置 ============
SEARCH_NUM_RESULTS=10
RISK_SEARCH_NUM_RESULTS=20
# 相关性分数阈值，低于此分数的检索结果将被丢弃（0.0 表示关闭过滤）
# 开启建议值：0.3，可根据实际效果调整
SEARCH_MIN_SCORE=0.0

# ============ 风险阈值配置 ============
RISK_THRESHOLD=0.7

# ============ 金融多维风险权重配置 ============
# 最终 risk_score = sum(dimension_scores[维度] * 对应权重)
RISK_WEIGHT_CUSTOMER_IDENTITY=0.15
RISK_WEIGHT_TRANSACTION_BEHAVIOR=0.25
RISK_WEIGHT_COUNTERPARTY=0.20
RISK_WEIGHT_AMOUNT_VELOCITY=0.15
RISK_WEIGHT_DEVICE_GEO=0.10
RISK_WEIGHT_HISTORY_CONTEXT=0.10
RISK_WEIGHT_COMPLIANCE_SIGNAL=0.05

# ============ Milvus 存储配置 ============
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MILVUS_GRPC_PORT=19530
MILVUS_HTTP_PORT=9091
ATTU_PORT=8002
MILVUS_URI=http://127.0.0.1:19530
MILVUS_TOKEN=
MILVUS_STASH_COLLECTION=events
EMBEDDING_DIM=1024
STASH_SEMANTIC_TOP_K=10
STASH_RERANK_ENABLED=true
STASH_RERANK_MIN_SCORE=0.7
BATCH_MAX_PER_PERSON=20
KV_TTL_DAYS=90

# ============ 黑名单配置 ============
BLACKLIST_EVENT_SIMILARITY_THRESHOLD=0.5
BLACKLIST_PERSON_MIN_HITS=1

# ============ Web 登录与权限 ============
# 默认开启。演示时如需临时开放写操作，可设为 false。
AUTH_ENABLED=true
# 管理员可维护黑名单、风险规则、删除事件并查看审计日志。
SENTINEL_ADMIN_TOKEN=sentinel-admin-token
# 审核员可提交分析任务和添加人工复核动作。
SENTINEL_REVIEWER_TOKEN=sentinel-reviewer-token
