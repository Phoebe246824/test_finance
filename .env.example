# ============ RabbitMQ 配置 ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=password

# ============ Neo4j 配置 ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# 调试模式：设为 true 跳过 Neo4j 写入（LLM 提取仍会执行）
GRAPHITI_DRY_RUN=false

# ============ LLM 配置 (聊天模型) ============
# ⚠️ 重要变更：默认 LLM 提供商已从 SiliconFlow 改为 OpenAI
# 如需继续使用 SiliconFlow，请修改下方配置：
#   LLM_PROVIDER=siliconflow
#   LLM_MODEL=deepseek-ai/DeepSeek-V3.2
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# ============ Embedding 配置 (嵌入模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_API_KEY=sk-your-api-key-here
EMBEDDER_API_BASE=https://api.siliconflow.cn/v1
EMBEDDING_DIM=1024

# ============ Reranker 配置 (重排序模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=sk-your-api-key-here
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# ============ 搜索配置 ============
SEARCH_NUM_RESULTS=10
RISK_SEARCH_NUM_RESULTS=20
# 相关性分数阈值，低于此分数的检索结果将被丢弃（0.0 表示关闭过滤）
# 开启建议值：0.3，可根据实际效果调整
SEARCH_MIN_SCORE=0.0

# ============ 风险阈值配置 ============
RISK_THRESHOLD=0.7

# ============ Redis 配置 (黑名单) ============
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
BLACKLIST_REDIS_DB=1

# ============ Milvus 配置 (事件暂存) ============
MILVUS_URI=http://localhost:19530
MILVUS_TOKEN=
MILVUS_STASH_COLLECTION=stashed_events
KV_TTL_DAYS=90
STASH_SEMANTIC_TOP_K=10
BATCH_MAX_PER_PERSON=20

# ============ 黑名单配置 ============
BLACKLIST_EVENT_SIMILARITY_THRESHOLD=0.5
BLACKLIST_PERSON_MIN_HITS=1
