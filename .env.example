# ============ RabbitMQ 配置 ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=password

# ============ Neo4j 配置 ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j
# 调试模式：设为 true 跳过 Neo4j 写入（LLM 提取仍会执行）
GRAPHITI_DRY_RUN=false

# ============ LLM 配置 (聊天模型) ============
# ⚠️ 重要变更：默认 LLM 提供商已从 SiliconFlow 改为 OpenAI
# 如需继续使用 SiliconFlow，请修改下方配置：
#   LLM_PROVIDER=siliconflow
#   LLM_MODEL=deepseek-ai/DeepSeek-V3.2
#   LLM_BASE_URL=https://api.siliconflow.cn/v1
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.openai.com/v1

# ============ Embedding 配置 (嵌入模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_API_KEY=sk-your-api-key-here
EMBEDDER_API_BASE=https://api.siliconflow.cn/v1

# ============ Reranker 配置 (重排序模型) ============
# 未设置时 fallback 到 LLM_API_KEY / LLM_BASE_URL
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_API_KEY=sk-your-api-key-here
RERANKER_BASE_URL=https://api.siliconflow.cn/v1

# ============ 搜索配置 ============
SEARCH_NUM_RESULTS=10
RISK_SEARCH_NUM_RESULTS=20
# 相关性分数阈值，低于此分数的检索结果将被丢弃（0.0 表示关闭过滤）
# 开启建议值：0.3，可根据实际效果调整
SEARCH_MIN_SCORE=0.0

# ============ 风险阈值配置 ============
RISK_THRESHOLD=0.7