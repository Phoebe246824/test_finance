# ============ RabbitMQ 配置 ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=root
RABBITMQ_PASSWORD=pa55w0rd

# ============ Neo4j 配置 ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=pa55w0rd
NEO4J_DATABASE=neo4j

# 调试模式：设为 true 跳过 Neo4j 写入（LLM 提取仍会执行）
GRAPHITI_DRY_RUN=false

# ============ LLM 提供商配置 ============
LLM_PROVIDER=siliconflow
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_API_KEY=sk-mopkqcqrsuhqyxewgzceuchsworefbqevbtafnbxyvqbtakr
LLM_BASE_URL=https://api.siliconflow.cn/v1

# ============ Embedding 配置 ============
EMBEDDER_MODEL=BAAI/bge-m3

# ============ Reranker 配置 ============
RERANKER_MODEL=BAAI/bge-reranker-v2-m3

# ============ 风险阈值配置 ============
RISK_THRESHOLD=0.1

# ============ 搜索配置 ============
# 普通搜索返回数量
SEARCH_NUM_RESULTS=20
# 风险二次评估时的主体关联历史检索返回数量
RISK_SEARCH_NUM_RESULTS=20
# 相关性分数阈值，低于此分数的检索结果将被丢弃（0.0 表示关闭过滤）
# 开启建议值：0.3，可根据实际效果调整
SEARCH_MIN_SCORE=0.3

# ============ 其他配置 ============true
CREWAI_TRACING_ENABLED=true
CREWAI_TELEMETRY_ENABLED=false #关闭遥感
CREWAI_DISABLE_TELEMETRY=true
