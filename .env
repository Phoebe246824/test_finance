# ============ RabbitMQ 配置 ============
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ============ Neo4j 配置 ============
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password
NEO4J_DATABASE=neo4j

# ============ LLM 提供商配置 ============
LLM_PROVIDER=siliconflow
#LLM_MODEL=Qwen/Qwen3-8B
LLM_MODEL=deepseek-ai/DeepSeek-V3.2
LLM_API_KEY=sk-mopkqcqrsuhqyxewgzceuchsworefbqevbtafnbxyvqbtakr
LLM_BASE_URL=https://api.siliconflow.cn/v1

# ============ Embedding 配置 ============
EMBEDDER_MODEL=BAAI/bge-m3
EMBEDDER_API_BASE=https://api.siliconflow.cn/v1

# ============ 风险阈值配置 ============
RISK_THRESHOLD=0.1

# ============ 搜索配置 ============
# 普通搜索返回数量
SEARCH_NUM_RESULTS=20
# 风险二次评估时的主体关联历史检索返回数量
RISK_SEARCH_NUM_RESULTS=20

# ============ 其他配置 ============true
CREWAI_TRACING_ENABLED=true
CREWAI_TELEMETRY_ENABLED=false #关闭遥感
CREWAI_DISABLE_TELEMETRY=true